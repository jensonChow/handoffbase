          "status": "active",
          "confidence": 0.94,
          "importance": 0.9,
          "scope": {},
          "metadata": {
            "synthetic": true,
            "publicSafe": true
          }
        }
      ],
      "steps": [
        {
          "op": "conflictRemember",
          "source": "user_correction",
          "content": "User now prioritizes credibility, founder network, and startup resources when evaluating AI events.",
          "approvalMode": "pending",
          "candidate": {
            "id": "bench-candidate-pref-credibility-network",
            "type": "user_preference",
            "canonicalText": "User now prioritizes credibility, founder network, and startup resources when evaluating AI events.",
            "status": "pending",
            "scope": {}
          },
          "conflict": {
            "id": "bench-conflict-pref-prize-vs-network",
            "existingMemoryId": "bench-pref-prize-money",
            "candidateMemoryId": "bench-candidate-pref-credibility-network",
            "conflictType": "contradiction",
            "recommendedAction": "supersede",
            "severity": "high",
            "reason": "The new preference reverses the older prize-money priority."
          },
          "expect": {
            "candidateStatus": "pending",
            "openConflictCount": 1,
            "conflictType": "contradiction",
            "recommendedAction": "supersede",
            "vaultConflictsCount": 1
          }
        }
      ],
      "metrics": [
        "conflict_created",
        "conflict_action_correct"
      ]
