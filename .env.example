HOST=127.0.0.1
PORT=3000
MCP_PATH=/mcp

# Remote MCP auth. Defaults to disabled for local smoke/demo.
# Set HANDOFFBASE_AUTH_MODE=api_key to require Authorization: Bearer <key>
# or X-Handoffbase-Api-Key on MCP POST requests.
HANDOFFBASE_AUTH_MODE=disabled

# Multi-key mapping. Values may also include actorType, actorId,
# allowedAgentProfileIds, and allowedProjectIds.
HANDOFFBASE_API_KEYS_JSON={"dev-key":{"tenantId":"demo-tenant","userId":"demo-user","actorId":"local-dev"}}

# Single-key dev fallback used only when HANDOFFBASE_AUTH_MODE=api_key.
HANDOFFBASE_API_KEY=
HANDOFFBASE_TENANT_ID=demo-tenant
HANDOFFBASE_USER_ID=demo-user
HANDOFFBASE_ACTOR_ID=local-dev

# Qwen Cloud / DashScope. If unset, the server uses MockMemoryProvider for local demo.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_MS=30000

# Optional DashScope naming aliases supported by QwenMemoryProvider.
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# Future Postgres runtime selection placeholders. PostgresMemoryStore is implemented,
# but the default server factory still uses the in-memory MVP store.
DATABASE_URL=
POSTGRES_URL=
STORE_MODE=in-memory

# Dashboard client. Default is mock; set to http to call the local Next.js API routes.
NEXT_PUBLIC_HANDOFFBASE_DASHBOARD_CLIENT=mock
# Optional when the dashboard API is hosted on a different origin.
NEXT_PUBLIC_HANDOFFBASE_DASHBOARD_API_BASE_URL=
