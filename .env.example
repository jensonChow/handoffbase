HOST=127.0.0.1
PORT=3000
MCP_PATH=/mcp

# Remote MCP auth. Defaults to disabled for local smoke/demo.
# Set HANDOFFBASE_AUTH_MODE=api_key to require Authorization: Bearer <key>
# or X-Handoffbase-Api-Key on MCP POST requests.
HANDOFFBASE_AUTH_MODE=disabled

# Fail-closed remote binding: auth-disabled servers may bind loopback only.
# Set to 1 only for an explicitly isolated demo (for example a Docker port
# published to 127.0.0.1), never for a shared or public deployment.
HANDOFFBASE_ALLOW_INSECURE_REMOTE=

# Multi-key mapping. Values may also include actorType, actorId,
# allowedAgentProfileIds, and allowedProjectIds.
HANDOFFBASE_API_KEYS_JSON={"dev-key":{"tenantId":"demo-tenant","userId":"demo-user","actorId":"local-dev"}}

# Single-key dev fallback used only when HANDOFFBASE_AUTH_MODE=api_key.
HANDOFFBASE_API_KEY=
HANDOFFBASE_TENANT_ID=demo-tenant
HANDOFFBASE_USER_ID=demo-user
HANDOFFBASE_ACTOR_ID=local-dev

# Qwen Cloud / DashScope. If unset, the server uses MockMemoryProvider for local demo.
# The default base URL is the INTERNATIONAL station (Qwen Cloud / Model Studio intl).
# A China-station (Bailian) key instead needs
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_MS=30000

# Semantic recall embeddings. Default is OFF (lexical recall) so the
# credential-free path stays deterministic. When Qwen/DashScope credentials are
# present, Qwen embeddings turn on automatically and recall blends cosine
# similarity into ranking. Force behavior with HANDOFFBASE_EMBEDDINGS:
#   (unset) = Qwen when credentials exist, else off; mock = deterministic offline
#   provider (demos/tests); off = disabled even with credentials.
# The Postgres memory_embeddings column is vector(1536), so the embedding model
# must output 1536 dims — text-embedding-v4 at 1536 is the default.
HANDOFFBASE_EMBEDDINGS=
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1536

# Dependency readiness. Qwen readiness performs a live one-token probe and caches
# it for five minutes by default; the timeout applies only to that readiness call.
HANDOFFBASE_READINESS_CACHE_MS=300000
HANDOFFBASE_READINESS_TIMEOUT_MS=5000

# Optional DashScope naming aliases supported by QwenMemoryProvider.
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# Runtime storage. The default is credential-free and process-local.
# When STORE_MODE=postgres, DATABASE_URL is required and the schema must first be
# applied explicitly with: DATABASE_URL=<local-or-secret-url> npm run db:migrate
DATABASE_URL=
STORE_MODE=in-memory

# Dashboard. The browser uses same-origin HTTP API routes by default. Set this
# server-only value to mock only for the isolated fixture demo.
HANDOFFBASE_DASHBOARD_CLIENT_MODE=

# Required when HANDOFFBASE_AUTH_MODE=api_key. Use a server-only random secret
# of at least 32 characters to sign the dashboard's HttpOnly session cookie.
# Never commit a real session secret.
HANDOFFBASE_DASHBOARD_SESSION_SECRET=

# The dashboard caller's tenant/user identity comes from the authenticated
# HandoffBase API-key mapping (or the fixed local demo caller when auth is
# disabled). These optional server-only values can only narrow that caller grant;
# they never establish identity and must not be exposed through NEXT_PUBLIC_*.
HANDOFFBASE_DASHBOARD_TENANT_ID=
HANDOFFBASE_DASHBOARD_USER_ID=
HANDOFFBASE_DASHBOARD_AGENT_PROFILE_ID=
HANDOFFBASE_DASHBOARD_PROJECT_ID=
HANDOFFBASE_DASHBOARD_HOST_ID=
